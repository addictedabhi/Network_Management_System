# Example environment for the BFF. PLACEHOLDERS ONLY.
# A real token, secret, or password in this file is a committed secret (NFR-09).
# Copy to .env (gitignored) and fill in locally; production values are injected at runtime.

NODE_ENV=development
PORT=4000
REDIS_URL=redis://localhost:6379
# The LibreNMS engine is REMOTE and HTTPS (recorded at Task 0.6 Step 11). Placeholder only.
LIBRENMS_BASE_URL=https://librenms.example.com
LIBRENMS_API_TOKEN=replace-me
LIBRENMS_UI_BASE_URL=https://librenms.example.com
OIDC_ISSUER_URL=https://idp.example.com/realms/nms
OIDC_CLIENT_ID=nms-custom-ui
OIDC_CLIENT_SECRET=replace-me
OIDC_REDIRECT_URI=http://localhost:4000/auth/callback
SESSION_COOKIE_NAME=nms_session
SESSION_IDLE_TIMEOUT_SECONDS=1800
SESSION_ABSOLUTE_LIFETIME_SECONDS=28800
ROLE_MAP={"nms-admin":"admin","nms-engineer":"engineer","nms-operator":"operator","nms-readonly":"readonly"}
AUTH_MODE=oidc
LOG_LEVEL=info
# Time-series store — InfluxDB v2 (ADR 0009). Server-side ONLY; the token never reaches the browser.
TSDB_URL=http://localhost:8086
TSDB_ORG=nms
TSDB_BUCKET=librenms
TSDB_TOKEN=replace-me
# POC self-signed-cert trust (optional). Paste the POC CA certificate PEM to trust the
# self-signed gateway WITHOUT disabling TLS verification. Leave unset in production.
# POC_TLS_CA_CERT="-----BEGIN CERTIFICATE-----\n...\n-----END CERTIFICATE-----"
