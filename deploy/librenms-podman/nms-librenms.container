[Unit]
Description=NMS LibreNMS web/PHP-FPM (collection engine - NEVER modified, FR-07)
After=nms-network.service nms-db.service nms-redis.service nms-rrdcached.service
Requires=nms-network.service nms-db.service

[Container]
ContainerName=nms-librenms
Image=docker.io/librenms/librenms:25.7.0
Network=nms.network
# NOT published. The proxy reaches it over the nms network only. On 0.4c this is the
# ONLY boundary protecting LibreNMS (no host firewall available) - see plan Task 0.5 Step 2.
Volume=nms-librenms-data:/data:Z
Volume=%h/nms/rrd:/data/rrd:z
EnvironmentFile=%h/nms/.env
Environment=TZ=UTC
Environment=PUID=1000
Environment=PGID=1000
Environment=DB_HOST=nms-db
Environment=DB_NAME=librenms
Environment=DB_USER=librenms
Environment=DB_TIMEOUT=60
Environment=REDIS_HOST=nms-redis
Environment=REDIS_PORT=6379
Environment=CACHE_DRIVER=redis
Environment=SESSION_DRIVER=redis
Environment=LIBRENMS_RRDCACHED_ENABLE=true
Environment=LIBRENMS_RRDCACHED_HOST=nms-rrdcached
Environment=LIBRENMS_RRDCACHED_PORT=42217
# CAP_NET_RAW: fping ships with cap_net_raw=ep but rootless userns drops it from the
# bounding set, so ICMP availability checks fail (validate.php FAIL). Verified rootless:
# --cap-add=net_raw restores it with NO sudo. Device availability depends on this.
AddCapability=net_raw
LogDriver=k8s-file
PodmanArgs=--log-opt max-size=10m

[Service]
Restart=on-failure
TimeoutStartSec=600

[Install]
WantedBy=default.target
