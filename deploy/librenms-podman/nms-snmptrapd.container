[Unit]
Description=NMS LibreNMS snmptrapd sidecar (traps on 1162/udp - FR-56a POC exception)
After=nms-network.service nms-db.service nms-librenms.service
Requires=nms-network.service nms-db.service

[Container]
ContainerName=nms-snmptrapd
Image=docker.io/librenms/librenms:25.7.0
# F-1 FIX (findings §F-1): pasta networking preserves the real source IP; the named `nms`
# bridge (netavark+rootlessport) masquerades it, so LibreNMS files traps against no device.
# ONLY the two receiver sidecars move to pasta; the other ~9 stay on `nms` (aardvark-dns +
# nginx resolve-per-request depend on it). --map-gw lets this pasta container reach the host's
# loopback-published MariaDB/Redis via the gateway address (findings §F-1 fallback, proven).
Network=pasta:--map-gw
# 1162 NOT 162: rootless Podman cannot bind <1024. FR-56a scoped exception (approved).
PublishPort=1162:162/udp
# Shared volume (librenms + 3 sidecars) -> :z (shared MCS label), NOT :Z. See nms-librenms.container.
Volume=nms-librenms-data:/data:z
EnvironmentFile=%h/nms/.env
Environment=TZ=UTC
Environment=PUID=1000
Environment=PGID=1000
Environment=SIDECAR_SNMPTRAPD=1
# On pasta the bridge name `nms-db` is unreachable; the host's loopback-published MariaDB/Redis
# are reached via the pasta gateway address (10.121.78.1). Kept externally invisible (9a passes:
# 127.0.0.1-only bind is not on any external interface).
Environment=DB_HOST=10.121.78.1
Environment=DB_NAME=librenms
Environment=DB_USER=librenms
Environment=DB_TIMEOUT=60
Environment=REDIS_HOST=10.121.78.1
Environment=REDIS_PORT=6379
LogDriver=k8s-file
PodmanArgs=--log-opt max-size=10m

[Service]
Restart=on-failure
TimeoutStartSec=300

[Install]
WantedBy=default.target
