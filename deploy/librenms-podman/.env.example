# NMS POC — rootless Podman deployment env template.
# PLACEHOLDERS ONLY. Real values are generated ON THE SERVER (Task 0.4c Step 7) with
# `openssl rand`, written to ~/nms/.env at mode 0600, and NEVER committed, logged,
# echoed, or recorded in any evidence file. Evidence records KEY=<set:NN> shape only.

# --- MariaDB (LibreNMS primary datastore) ---
MARIADB_PASSWORD=__PLACEHOLDER__
MARIADB_ROOT_PASSWORD=__PLACEHOLDER__
DB_PASSWORD=__PLACEHOLDER__

# --- InfluxDB v2 (metric store, OQ-3 re-answered - ADR 0009 / ADR 0005 rev 3-b) ---
# Init/admin credentials + operator token. Placeholders only; real values generated on the
# server at Task 0.4c Step 7 with `openssl rand`, written to ~/nms/.env (0600), NEVER committed.
# The operator token is what LibreNMS uses to write and the BFF uses to read - held server-side only.
DOCKER_INFLUXDB_INIT_USERNAME=__PLACEHOLDER__
DOCKER_INFLUXDB_INIT_PASSWORD=__PLACEHOLDER__
DOCKER_INFLUXDB_INIT_ADMIN_TOKEN=__PLACEHOLDER__

# --- SNMP (simulated devices only in this phase) ---
SNMP_COMMUNITY=__PLACEHOLDER__

# --- LibreNMS REST API token for the BFF (created at Task 0.6 Step 1) ---
LIBRENMS_API_TOKEN=__PLACEHOLDER__

# --- OIDC client secret for the gateway (Task 0.5 Step 4) ---
OIDC_CLIENT_SECRET=__PLACEHOLDER__
