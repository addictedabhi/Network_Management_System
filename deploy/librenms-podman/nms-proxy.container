[Unit]
Description=NMS TLS gateway (8443/8080) - the only published TCP ports
After=nms-network.service nms-librenms.service
Requires=nms-network.service

[Container]
ContainerName=nms-proxy
Image=docker.io/library/nginx:1.27-alpine
# Static IP on the nms bridge so LibreNMS's sso.trusted_proxies is STABLE across restarts
# (a dynamic proxy IP causes AuthenticationException "did not originate from trusted source").
Network=nms.network
IP=10.89.0.10
# The ONLY two published TCP ports in the whole stack.
PublishPort=8080:8080
PublishPort=8443:8443
# nginx.conf is single-consumer -> :Z. The TLS dir is now SHARED with the BFF (which reads the CA
# cert), so it must be :z (shared label); :Z would give each container a private MCS category and
# nginx could not read a cert relabelled by the other consumer (the recurring :z/:Z lesson).
Volume=%h/nms/config/nginx.conf:/etc/nginx/nginx.conf:Z,ro
Volume=%h/nms/config/tls:/etc/nginx/tls:z,ro
LogDriver=k8s-file
PodmanArgs=--log-opt max-size=10m

[Service]
Restart=on-failure

[Install]
WantedBy=default.target
