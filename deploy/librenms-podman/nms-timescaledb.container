[Unit]
Description=NMS TimescaleDB (time-series metric store, OQ-3)
After=nms-network.service
Requires=nms-network.service

[Container]
ContainerName=nms-timescaledb
Image=docker.io/timescale/timescaledb:2.17.2-pg16
Network=nms.network
# NOT published - a published 5432 is a defect (plan Task 0.4a Step 5 / 0.6 Step 9a)
Volume=nms-tsdb-data:/var/lib/postgresql/data:Z
EnvironmentFile=%h/nms/.env
Environment=POSTGRES_DB=nmsmetrics
Environment=POSTGRES_USER=nms
# Retention policy bootstrap - PRECONDITION OF FIRST START. Mounted read-only; the
# image executes *.sql in this directory once, on first initialisation of the data dir.
Volume=%h/nms/config/tsdb-init:/docker-entrypoint-initdb.d:z,ro
LogDriver=k8s-file
PodmanArgs=--log-opt max-size=10m

[Service]
Restart=on-failure
TimeoutStartSec=300

[Install]
WantedBy=default.target
